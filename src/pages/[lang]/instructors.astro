---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import InstructorCard from '../../components/InstructorCard.astro';
import { ui, locales } from '../../i18n/content';
import type { Lang } from '../../i18n/content';
export const getStaticPaths = () => locales.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={ui.instructors.title[lang]} description={ui.instructors.sub[lang]} path="instructors">
  <PageHero title={ui.instructors.title[lang]} sub={ui.instructors.sub[lang]} />
  <section class="container-x py-14">
    <div class="grid gap-6 md:grid-cols-2">
      {ui.instructors.people.map((p) => <InstructorCard p={p} lang={lang} />)}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
