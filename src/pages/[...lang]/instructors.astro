---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import InstructorCard from '../../components/InstructorCard.astro';
import { ui } from '../../i18n/content';
import { langPaths, langFromParam, localePath } from '../../i18n/utils';
export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
---
<Base lang={lang} title={ui.instructors.title[lang]} description={ui.instructors.sub[lang]} path="instructors">
  <PageHero title={ui.instructors.title[lang]} sub={ui.instructors.sub[lang]} />
  <section class="container-x py-14">
    <div class="grid gap-6 md:grid-cols-2">
      {ui.instructors.people.map((p) => <InstructorCard p={p} lang={lang} />)}
    </div>
  </section>
  <CtaBand lang={lang} />
</Base>
