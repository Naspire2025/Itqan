---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { ui, site } from '../../i18n/content';
import { langPaths, langFromParam, localePath } from '../../i18n/utils';
export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const s = ui.schedule;
---
<Base lang={lang} title={ui.nav.program[lang]} description={ui.hero.sub[lang]} path="program">
  <PageHero eyebrow={site.program} title={ui.nav.program[lang]} sub={ui.hero.sub[lang]} />

  <section class="container-x py-14">
    <h2 class="h2">{ui.outcomes.title[lang]}</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {ui.outcomes.items[lang].map((t) => (
        <li class="flex gap-3 rounded-lg border border-brand-100 p-4 text-sm">
          <svg class="mt-0.5 shrink-0 text-brand-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5 9-10"/></svg>
          <span>{t}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-brand-50">
    <div class="container-x py-14">
      <h2 class="h2">{s.title[lang]}</h2>
      <p class="mt-2 text-ink/70">{s.sub[lang]}</p>
      <div class="mt-8 space-y-3">
        {s.days.map((d, i) => (
          <details class="group rounded-xl border border-brand-100 bg-white" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center gap-4 p-5">
              <span class="flex h-11 w-11 shrink-0 flex-col items-center justify-center rounded-lg bg-brand-600 text-white" dir="ltr">
                <span class="text-[10px] uppercase leading-none opacity-80">{s.dayLabel.en}</span>
                <span class="text-lg font-bold leading-none">{i + 1}</span>
              </span>
              <span class="flex-1 font-semibold text-brand-900">{d.title[lang]}</span>
              <svg class="shrink-0 transition-transform group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <ul class="list-disc space-y-1.5 border-t border-brand-100 px-5 pb-5 pt-4 ps-10 text-sm marker:text-brand-400">
              {d.items[lang].map((t: string) => <li>{t}</li>)}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="container-x py-14">
    <h2 class="h2">{ui.outlines.title[lang]}</h2>
    <ol class="mt-8 grid gap-x-10 text-sm sm:grid-cols-2">
      {ui.outlines.items[lang].map((t, i) => (
        <li class="flex gap-3 border-b border-brand-100 py-2.5">
          <span class="w-6 shrink-0 font-semibold text-accent" dir="ltr">{String(i + 1).padStart(2, '0')}</span><span>{t}</span>
        </li>
      ))}
    </ol>
    <h2 class="h2 mt-14">{ui.includes.title[lang]}</h2>
    <ul class="mt-6 flex flex-wrap gap-2">
      {ui.includes.items[lang].map((t) => <li class="rounded-full bg-brand-50 px-4 py-2 text-sm text-brand-800">{t}</li>)}
    </ul>
  </section>
  <CtaBand lang={lang} />
</Base>
