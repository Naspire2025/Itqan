---
interface Props { eyebrow?: string; title: string; sub?: string }
const { eyebrow, title, sub } = Astro.props;
---
<section class="bg-gradient-to-b from-brand-50 to-white border-b border-brand-100">
  <div class="container-x py-14 sm:py-20">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="mt-2 max-w-3xl text-4xl font-bold tracking-tight text-brand-900 sm:text-5xl">{title}</h1>
    {sub && <p class="mt-4 max-w-2xl text-lg text-ink/70">{sub}</p>}
  </div>
</section>
