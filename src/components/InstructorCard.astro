---
import type { Lang } from '../i18n/content';
const { p, lang, compact = false } = Astro.props as { p: any; lang: Lang; compact?: boolean };
---
<article class="flex flex-col rounded-xl border border-brand-100 bg-white p-6">
  <div class="flex items-center gap-4">
    <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full bg-brand-100">
      <img src={`/images/instructors/${p.slug}.png`} alt={p.name[lang]} class="h-full w-full object-cover object-top" loading="lazy" />
    </div>
    <div>
      <h3 class="text-lg font-bold text-brand-900">{p.name[lang]}</h3>
      <p class="text-sm text-accent">{p.role[lang]}</p>
    </div>
  </div>
  {!compact && (
    <ul class="mt-4 list-disc space-y-1.5 ps-5 text-sm text-ink/80 marker:text-brand-400">
      {p.bio[lang].map((b: string) => <li>{b}</li>)}
    </ul>
  )}
</article>
