---
import { site, ui } from '../i18n/content';
import type { Lang } from '../i18n/content';
import { localePath } from '../i18n/utils';
interface Props { lang: Lang }
const { lang } = Astro.props;
const n = ui.nav;
const to = (p: string) => localePath(lang, p);
---
<footer class="bg-brand-900 text-white/80">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <img src="/images/logo-iba.png" alt="iba" class="h-10 w-auto rounded bg-white p-1" />
      <p class="mt-4 text-sm">{site.name[lang]}</p>
      <p class="mt-1 text-sm text-white/60">{ui.footer.tagline[lang]}</p>
    </div>
    <nav aria-label="Footer" class="grid grid-cols-2 gap-2 text-sm">
      <a class="hover:text-white" href={to('')}>{n.home[lang]}</a>
      <a class="hover:text-white" href={to('program')}>{n.program[lang]}</a>
      <a class="hover:text-white" href={to('pricing')}>{n.pricing[lang]}</a>
      <a class="hover:text-white" href={to('instructors')}>{n.instructors[lang]}</a>
      <a class="hover:text-white" href={to('accreditations')}>{n.accreditations[lang]}</a>
      <a class="hover:text-white" href={to('contact')}>{n.contact[lang]}</a>
    </nav>
    <div class="text-sm">
      {site.emails.map((e) => <a class="block hover:text-white" href={`mailto:${e}`}>{e}</a>)}
      {site.phones.map((p) => <a class="mt-1 block hover:text-white" dir="ltr" style="text-align:start" href={`tel:${p.number.replace(/\s/g, '')}`}>{p.country[lang]} · {p.number}</a>)}
    </div>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs text-white/50">
    © {new Date().getFullYear()} {site.name[lang]} · {ui.footer.rights[lang]}
  </div>
</footer>
