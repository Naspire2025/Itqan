---
import { ui } from '../i18n/content';
import type { Lang } from '../i18n/content';
import { localePath } from '../i18n/utils';
const { lang } = Astro.props as { lang: Lang };
---
<section class="bg-brand-600 text-white">
  <div class="container-x flex flex-col items-start gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-2xl font-bold sm:text-3xl">{ui.cta.title[lang]}</h2>
      <p class="mt-2 text-white/85">{ui.cta.sub[lang]}</p>
    </div>
    <a href={localePath(lang, 'contact')} class="btn btn-primary shrink-0">{ui.nav.enroll[lang]}</a>
  </div>
</section>
